# Database connection string (e.g. from TiDB Cloud, Aiven, PlanetScale, Railway, AWS RDS)
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/notes_db

# Or configure via individual variables:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=notes_db
# DB_SSL=false

# Optional: Comma-separated list of allowed frontend domains for CORS
# (Defaults to allowing all origins if left blank)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
